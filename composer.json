{
  "name": "leafs/schema",
  "description": "Git for your database",
  "keywords": [
    "migrations",
    "schema",
    "database",
    "leaf",
    "php"
  ],
  "homepage": "https://leafphp.dev/docs/database/files.html",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Darko",
      "email": "mickdd22@gmail.com",
      "homepage": "https://mychi.netlify.app",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Leaf\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/database": "*",
    "illuminate/support": "*",
    "fakerphp/faker": "*",
    "leafs/date": "^5.0",
    "leafs/fs": "^5.0",
    "symfony/yaml": "*",
    "leafs/sprout": "^5.0"
  },
  "require-dev": {
    "leafs/alchemy": "^5.0",
    "friendsofphp/php-cs-fixer": "*",
    "pestphp/pest": "*"
  },
  "scripts": {
    "alchemy": "@php vendor/bin/alchemy all",
    "test": "@php vendor/bin/alchemy test",
    "lint": "@php vendor/bin/alchemy lint",
    "fmt": "@php vendor/bin/alchemy fmt",
    "analyse": "@php vendor/bin/alchemy analyse",
    "refactor": "@php vendor/bin/alchemy refactor",
    "ci": "@php vendor/bin/alchemy ci"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
